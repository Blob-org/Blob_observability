// Ships the Blob_storage system's container logs to Loki.
//
// Every stream gets two labels from Docker Compose:
//   project   = compose project (auth-service, blob-service, api-gateway, blob-frontend)
//   container = compose service (auth, blob, gateway, frontend)
// The backend services log one JSON object per line; for those, `level`
// becomes a label too, and `requestId` is kept as structured metadata so you
// can filter on it without making a label per request.

discovery.docker "containers" {
	host = "unix:///var/run/docker.sock"
}

discovery.relabel "containers" {
	targets = discovery.docker.containers.targets

	// Only this system's stacks, not this one or anything else on the machine.
	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
		regex         = "auth-service|blob-service|api-gateway|blob-frontend"
		action        = "keep"
	}

	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
		target_label  = "project"
	}

	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
		target_label  = "container"
	}
}

loki.source.docker "containers" {
	host          = "unix:///var/run/docker.sock"
	targets       = discovery.docker.containers.targets
	relabel_rules = discovery.relabel.containers.rules
	forward_to    = [loki.process.json.receiver]
}

loki.process "json" {
	// Lines that aren't JSON (e.g. Next.js output) pass through unchanged.
	stage.json {
		expressions = {
			level     = "",
			time      = "",
			requestId = "",
		}
	}

	stage.labels {
		values = {
			level = "",
		}
	}

	stage.structured_metadata {
		values = {
			requestId = "",
		}
	}

	// Use the service's own timestamp, not when Alloy read the line.
	stage.timestamp {
		source = "time"
		format = "RFC3339"
	}

	forward_to = [loki.write.local.receiver]
}

loki.write "local" {
	endpoint {
		url = "http://loki:3100/loki/api/v1/push"
	}
}
